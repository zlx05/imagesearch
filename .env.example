# ── HTTP 代理（端口代理模式时取消注释；TUN 模式时注释掉）──
# HTTP_PROXY=http://127.0.0.1:7892
# HTTPS_PROXY=http://127.0.0.1:7892

# ── Firecrawl API（网页抓取，JS 渲染 + 反爬代理）──
FIRECRAWL_API_KEY=fc-your-firecrawl-key

# ── LLM（DeepSeek / OpenAI 兼容 API）──
LLM_API_KEY=sk-your-openai-compatible-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

# ── 百度 OCR（水印检测 & 文字比对）──
BAIDU_OCR_API_KEY=your-baidu-ocr-api-key
BAIDU_OCR_SECRET_KEY=your-baidu-ocr-secret-key
BAIDU_OCR_API_URL=https://aip.baidubce.com/rest/2.0/ocr/v1/general

# ── Validator 配置 ──
VALIDATOR_ENABLE_OCR=true
VALIDATOR_ENABLE_OCR_PREFILTER=true
VALIDATOR_OCR_PREFILTER_VISUAL_THRESHOLD=0.62
VALIDATOR_OCR_PREFILTER_TEXT_THRESHOLD=0.12
VALIDATOR_ENABLE_MULTIMODAL_LLM=true
VALIDATOR_CACHE_DIR=data/cache/validator
VALIDATOR_ENABLE_IMAGE_CACHE=true
VALIDATOR_ENABLE_OCR_CACHE=true
VALIDATOR_ENABLE_CLIP_FEATURE_CACHE=true
VALIDATOR_PROGRESS_INTERVAL=1

# ── Tikomni（微博 / 小红书结构化数据 API）──
TIKOMNI_API_KEY=your-tikomni-api-key
ANALYZER_ENABLE_TIKOMNI=true
TIKOMNI_BASE_URL=https://api.tikomni.com
TIKOMNI_AUTH_HEADER=Authorization
TIKOMNI_AUTH_SCHEME=Bearer
ANALYZER_TIKOMNI_TIMEOUT_SECONDS=20
TIKOMNI_WEIBO_STATUS_DETAIL_ENDPOINT=/api/u1/v1/weibo/app/fetch_status_detail
TIKOMNI_XHS_NOTE_INFO_V7_ENDPOINT=/api/u1/v1/xiaohongshu/web/get_note_info_v7

# ── CLIP 视觉语义模型 ──
VALIDATOR_ENABLE_CLIP=true
VALIDATOR_CLIP_MODEL=openai/clip-vit-base-patch32
VALIDATOR_CLIP_LOCAL_ONLY=true
HF_ENDPOINT=https://hf-mirror.com
HF_HOME=data/model_cache/huggingface
TRANSFORMERS_CACHE=data/model_cache/huggingface/transformers
HF_HUB_DISABLE_XET=1
HF_HUB_DISABLE_AUTO_CONVERSION=1
TRANSFORMERS_VERBOSITY=error

# ── 相似度阈值 ──
SIMILARITY_THRESHOLD=0.90
VALIDATOR_HASH_STRONG_PASS_THRESHOLD=0.92
VALIDATOR_HASH_WEAK_PASS_THRESHOLD=0.72
VALIDATOR_CLIP_REVIEW_THRESHOLD=0.78
VALIDATOR_LLM_BOUNDARY_SIMILARITY_FLOOR=0.75
VALIDATOR_JOINT_DEDUP_THRESHOLD=0.86
VALIDATOR_SAME_IMAGE_TEXT_DIFFERENT_THRESHOLD=0.25
VALIDATOR_TAMPERING_TEXT_SIGNAL_THRESHOLD=0.35
VALIDATOR_TAMPERING_CLIP_FLOOR=0.55

# ── OCR 引擎链 & 回退策略 ──
# 多引擎链（rapidocr,paddleocr_vl,baidu），空结果时是否继续尝试下一个引擎
VALIDATOR_OCR_PROVIDER=rapidocr,paddleocr_vl,baidu
VALIDATOR_OCR_FALLBACK_ON_EMPTY=false

# ── 搜索引擎配置 ──
SEARCH_ENGINE=baidu,tineye,yandex,bing,google,saucenao,ascii2d,serpapi_lens,mitmproxy
MITMPROXY_MAX_PER_PLATFORM=150
RETRIEVER_ENGINE_TIMEOUT_SECONDS=90
RETRIEVER_ENGINE_LIMITS=baidu:20,tineye:8,yandex:12,bing:10,google:10,saucenao:8,ascii2d:8,serpapi_lens:10,mitmproxy:160

# ── Analyzer 爬虫 & LLM 配置 ──
ANALYZER_ENABLE_FIRECRAWL=true
ANALYZER_ENABLE_LLM=true
ANALYZER_MAX_FIRECRAWL_NODES=25
ANALYZER_MAX_LLM_NODES=25
ANALYZER_MAX_PAGE_FETCH_NODES=30
ANALYZER_MAX_WORKERS=15
ANALYZER_MAX_LLM_ENRICHMENT_NODES=20
ANALYZER_ENABLE_LLM_RELATION_ANALYSIS=true
ANALYZER_LLM_RELATION_TIMEOUT_SECONDS=75
ANALYZER_MAX_LLM_RELATION_NODES=12
ANALYZER_MIN_SIMILARITY_DEEP_ANALYSIS=0.60
ANALYZER_FIRECRAWL_TIMEOUT_MS=15000
ANALYZER_LLM_TIMEOUT_SECONDS=20
ANALYZER_PAGE_FETCH_TIMEOUT_SECONDS=10

# ── llmscrapy — LLM 网页抓取（替代旧 Firecrawl 直连）──
ANALYZER_ENABLE_LLMSCRAPY=true
ANALYZER_LLMSCRAPY_FETCHER=firecrawl
ANALYZER_LLMSCRAPY_ENRICH_MODE=baidu
ANALYZER_LLMSCRAPY_MAX_WORKERS=5
ANALYZER_MAX_LLMSCRAPY_NODES=200
# llmscrapy 默认复用 LLM_API_KEY；如需独立 key 可改 DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── SerpApi / Imgur（Google Lens 搜图）──
SERPAPI_API_KEY=your-serpapi-api-key
IMGUR_CLIENT_ID=your-imgur-client-id
